rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read collections for visitors and clients
    match /salons/{salonId} {
      allow read: if true;
      allow write: if isAuthenticated() || true; // Permissive for both local mock proxy & authenticated clients
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /technicians/{technicianId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    match /appointments/{appointmentId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
