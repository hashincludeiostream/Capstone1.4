rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'hasincludeionull@gmail.com',
          'medayojessemuel@gmail.com',
          'jessemuelmedayo02@gmail.com',
          'medayojeuelsam@gmail.com',
          'admin@nailglamhub.com',
          'oncinesjanmer@gmail.com'
        ]
      );
    }

    // Public catalog & directory collections
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    match /salons/{salonId} {
      allow read, write: if true;
    }

    match /services/{serviceId} {
      allow read, write: if true;
    }

    match /technicians/{technicianId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }

    match /promotions/{promotionId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    match /reels/{reelId} {
      allow read, write: if true;
    }

    match /working_hours/{workingHoursId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // User accounts, appointments, transactions, orders, messages, notifications
    match /users/{userId} {
      allow read, write: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /product_orders/{orderId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /system_notifications/{notificationId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Default match for any subcollections or additional tables
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

