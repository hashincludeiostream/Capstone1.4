# Nail Glam Hub - Environment Configuration Template
# Copy this file to .env and customize with your credentials.
# NOTE: Never commit your real .env file with secrets to source control.

# ==============================================================================
# Central Email Sender & SMTP Configuration (Single Central Mailer)
# All system-generated emails (bookings, cancellations, owner alerts, receipts,
# reports, and password notices) will be sent using these central settings.
# ==============================================================================

# The official email address displayed as the central system sender (RFC 5322 format).
# Example: noreply@nailglamhub.com or notifications@yourdomain.com
SYSTEM_SENDER_EMAIL=noreply@example.com

# The human-friendly display name shown in recipients' inboxes.
SYSTEM_SENDER_NAME=Nail Glam Hub

# SMTP server hostname.
# Examples:
#   Gmail: smtp.gmail.com
#   SendGrid: smtp.sendgrid.net
#   Amazon SES: email-smtp.us-east-1.amazonaws.com
#   Mailgun: smtp.mailgun.org
#   Custom/Internal: mail.yourdomain.com
SMTP_HOST=smtp.example.com

# SMTP server port (587 for STARTTLS, 465 for SSL/TLS, 2525 for alternative STARTTLS).
SMTP_PORT=587

# SMTP authentication username / account.
# For Gmail: your full gmail address (e.g., mailer@gmail.com)
# For SendGrid: "apikey"
# For Amazon SES: your SES SMTP username
SMTP_USER=smtp-user@example.com

# SMTP authentication password or provider-specific app password.
# IMPORTANT: For Gmail, generate a 16-character App Password (requires 2FA enabled).
# Never use your personal login password. Never commit this value.
SMTP_PASS=your-smtp-password-or-app-password

# TLS security mode:
# - Set to "false" when using port 587 or 2525 (opportunistic TLS / STARTTLS).
# - Set to "true" when using port 465 (direct SSL/TLS wrapper).
SMTP_SECURE=false

# Optional: set to "true" only in private local development environments with self-signed certificates.
SMTP_IGNORE_TLS_ERRORS=false

# ==============================================================================
# Application Server & Security
# ==============================================================================
PORT=3000
JWT_SECRET=replace_with_a_long_random_jwt_secret_token
SESSION_SECRET=replace_with_a_long_random_session_secret_token
ADMIN_CODES=ADMIN2025,NAILGLAM_MASTER_2025
ENABLE_REGISTRATION_RATE_LIMIT=true

# ==============================================================================
# Gemini AI Configuration
# ==============================================================================
GEMINI_API_KEY=

# ==============================================================================
# Firebase Configuration
# ==============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
ADMIN_CODES=
ENABLE_REGISTRATION_RATE_LIMIT=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_API_KEY=

# ==============================================================================
# Payment Gateways & Maps
# ==============================================================================
FIREBASE_DATABASE_ID=
FIREBASE_PROJECT_ID=
GEMINI_API_KEY=
JWT_SECRET=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_URL=
SESSION_SECRET=
SMTP_HOST=
SMTP_IGNORE_TLS_ERRORS=
SMTP_PASS=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SYSTEM_SENDER_EMAIL=
SYSTEM_SENDER_NAME=
VITE_API_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_GOOGLE_MAPS_API_KEY=