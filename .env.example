# Application Environment Variables
PORT=3001
NODE_ENV=development

# Database Configuration (XAMPP/MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=nailglamhub_db

# Admin Security Codes (comma-separated)
ADMIN_CODES=ADMIN2025,GLAM_ADMIN,ADMIN,SUPERADMIN

# Google Maps Platform (Optional: For custom Google Maps Platform API key or Demo Key)
VITE_GOOGLE_MAPS_API_KEY=

# Registration Rate Limiting
ENABLE_REGISTRATION_RATE_LIMIT=true
