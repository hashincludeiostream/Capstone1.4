# ==============================================================================
# NAIL GLAM HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Runtime Port
PORT=3000

# Security & Session Authentication
SESSION_SECRET=your_long_random_session_secret_key_here
JWT_SECRET=your_long_random_jwt_secret_key_here

# Administrator Clearance Codes (Comma-separated passphrases for admin gate)
ADMIN_CODES=NGH-ADMIN-SECURE-2025-AUTH,MASTER-NAIL-GLAM-ADMIN-2026

# Registration Rate Limiting (true | false)
ENABLE_REGISTRATION_RATE_LIMIT=true

# ==============================================================================
# SPECIALIZED SYSTEM SMTP EMAIL DISPATCHER
# ==============================================================================
# Nail Glam Hub uses a dedicated system mailbox for sending automated booking
# confirmations, order pickup notices, schedule alerts, and executive PDF reports.
#
# --- GMAIL SMTP CONFIGURATION GUIDE ---
# 1. Enable 2-Step Verification on your Google Account:
#    https://myaccount.google.com/security
# 2. Generate an App Password (do NOT use your standard account password):
#    https://myaccount.google.com/apppasswords
#    - App: Mail
#    - Device: Other (Nail Glam Hub)
# 3. Paste the generated 16-character password into SMTP_PASS below (without spaces).
#
# Common SMTP Providers:
# - Gmail:         SMTP_HOST=smtp.gmail.com         SMTP_PORT=587  SMTP_SECURE=false
# - SendGrid:      SMTP_HOST=smtp.sendgrid.net      SMTP_PORT=587  SMTP_SECURE=false
# - Mailgun:       SMTP_HOST=smtp.mailgun.org       SMTP_PORT=587  SMTP_SECURE=false
# - Amazon SES:    SMTP_HOST=email-smtp.us-east-1.amazonaws.com SMTP_PORT=587
# - Brevo/Sendinblue: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications.nailglamhub@gmail.com
SMTP_PASS=your_16_char_app_password
SYSTEM_SENDER_EMAIL=notifications.nailglamhub@gmail.com
SYSTEM_SENDER_NAME=Nail Glam Hub System

# Optional: Set to true if testing self-signed or enterprise TLS proxy certificates
SMTP_IGNORE_TLS_ERRORS=false

# ==============================================================================
# GOOGLE GEMINI AI ASSISTANT (GlamBot Co-Pilot)
# ==============================================================================
GEMINI_API_KEY=

