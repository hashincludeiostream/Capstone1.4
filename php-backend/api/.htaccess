# Apache URL Rewriting for XAMPP
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /nailglamhub/php-backend/api/

    # Allow direct file access if file exists
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Map /categories -> categories.php
    RewriteRule ^categories/?$ categories.php [L,QSA]
    
    # Map /salons -> salons.php
    RewriteRule ^salons/?$ salons.php [L,QSA]
    RewriteRule ^salons/([0-9]+)/?$ salons.php?id=$1 [L,QSA]

    # Map /services -> services.php
    RewriteRule ^services/?$ services.php [L,QSA]

    # Map /technicians -> technicians.php
    RewriteRule ^technicians/?$ technicians.php [L,QSA]

    # Map /appointments -> appointments.php
    RewriteRule ^appointments/?$ appointments.php [L,QSA]

    # Map /reviews -> reviews.php
    RewriteRule ^reviews/?$ reviews.php [L,QSA]

    # Map /reels -> reels.php
    RewriteRule ^reels/?$ reels.php [L,QSA]

    # Map /promotions -> promotions.php
    RewriteRule ^promotions/?$ promotions.php [L,QSA]

    # Map /announcements -> announcements.php
    RewriteRule ^announcements/?$ announcements.php [L,QSA]

    # Map /auth/login & /auth/register -> auth.php
    RewriteRule ^auth/login/?$ auth.php?action=login [L,QSA]
    RewriteRule ^auth/register/?$ auth.php?action=register [L,QSA]
</IfModule>
